APP_NAME=Revora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vj_lead_revora
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Platform ---------------------------------------------------------------
PLATFORM_DOMAIN=localhost
TENANT_TRIAL_DAYS=14

# --- AI providers (§4: provider-agnostic, never hard-coded) -----------------
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Messaging providers ----------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Integration providers (OAuth) ------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing ----------------------------------------------------------------
BILLING_PROVIDER=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Brand ------------------------------------------------------------------
# Which of the eight candidate identities is active. See config/brand.php.
BRAND_KEY=revora
# Allows /brand to preview other identities per-session. Set false once the
# brand is finalised.
BRAND_PREVIEW=true

# Coming-soon countdown. Leave blank to hide it — an invented launch date is a
# promise to visitors. Example: 2026-12-01 09:00:00
APP_LAUNCH_AT=

# --- Public site ------------------------------------------------------------
# coming_soon = "/" is the coming-soon page, landing previewable at /home
# live        = "/" is the marketing landing page
SITE_MODE=coming_soon

SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
SITE_WHATSAPP=
SITE_DEMO_URL=
SITE_LINKEDIN=
SITE_YOUTUBE=
SITE_INSTAGRAM=
SITE_X=
